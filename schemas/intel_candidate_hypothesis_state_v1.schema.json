{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nangman.local/contracts/intel-candidate/intel_candidate_hypothesis_state_v1.schema.json",
  "title": "Intel Candidate Hypothesis State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "state_key",
    "schema_version",
    "producer_app",
    "producer_version",
    "created_at_ms",
    "updated_at_ms",
    "input_packet_id",
    "input_packet_family_id",
    "input_packet_revision",
    "source_structured_packet_ids",
    "source_event_ids",
    "latest_screening_event_id",
    "scoring_policy_version",
    "normalized_symbols",
    "event_type",
    "hypothesis_type",
    "current_state",
    "current_score",
    "previous_score",
    "research_eligible",
    "transition",
    "next_action",
    "reasons",
    "retryable_reasons",
    "terminal_reasons",
    "selected_market_artifacts",
    "market_context_status",
    "evidence_quality_reasons",
    "score_breakdown",
    "lineage_refs",
    "dirty_triggers",
    "harness_queue_hint",
    "idempotency_key",
    "checksum"
  ],
  "properties": {
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "state_key": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "intel_candidate_hypothesis_state_v1" },
    "producer_app": { "const": "intel-candidate-app" },
    "producer_version": { "type": "string", "minLength": 1 },
    "created_at_ms": { "type": "integer" },
    "updated_at_ms": { "type": "integer" },
    "input_packet_id": { "type": "string", "minLength": 1 },
    "input_packet_family_id": { "type": "string", "minLength": 1 },
    "input_packet_revision": { "type": "integer", "minimum": 0 },
    "source_structured_packet_ids": { "type": "array", "items": { "type": "string" } },
    "source_event_ids": { "type": "array", "items": { "type": "string" } },
    "supersedes_packet_id": { "type": ["string", "null"] },
    "supersedes_hypothesis_id": { "type": ["string", "null"] },
    "latest_screening_event_id": { "type": "string", "minLength": 1 },
    "scoring_policy_version": { "type": "string", "minLength": 1 },
    "normalized_symbols": { "type": "array", "items": { "type": "string" } },
    "event_type": { "type": "string", "minLength": 1 },
    "hypothesis_type": { "type": "string", "minLength": 1 },
    "current_state": { "$ref": "#/$defs/candidate_class" },
    "current_score": { "type": "integer" },
    "previous_score": { "type": ["integer", "null"] },
    "research_eligible": { "type": "boolean" },
    "transition": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "retryable_reasons": { "type": "array", "items": { "type": "string" } },
    "terminal_reasons": { "type": "array", "items": { "type": "string" } },
    "selected_market_artifacts": { "type": "array", "items": { "type": "object" } },
    "market_context_ref": { "type": ["object", "null"] },
    "market_context_status": {
      "type": "string",
      "enum": [
        "available",
        "available_symbol_context",
        "available_general_context",
        "nearest_available",
        "symbol_context_only",
        "stale_but_usable",
        "pending",
        "unavailable",
        "unknown"
      ]
    },
    "evidence_quality_reasons": { "type": "array", "items": { "type": "string" } },
    "score_breakdown": { "type": "object" },
    "lineage_refs": { "type": "array", "items": { "type": "string" } },
    "dirty_triggers": { "type": "array", "items": { "type": "string" } },
    "harness_queue_hint": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "candidate_class": {
      "type": "string",
      "enum": ["strong_candidate", "research_candidate", "weak_candidate", "observe_only", "reject", "quarantine"]
    }
  }
}
