{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nangman.local/contracts/intel-candidate/intel_candidate_evidence_bundle_v1.schema.json",
  "title": "Intel Candidate Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "candidate_lifecycle_key",
    "bundle_key",
    "producer_app",
    "producer_run_id",
    "created_at_ms",
    "event_time_ms",
    "published_at_ms",
    "fetched_at_ms",
    "structured_at_ms",
    "candidate_created_at_ms",
    "decision_available_at_ms",
    "forbidden_lookahead_boundary_ms",
    "schema_version",
    "scoring_policy_version",
    "normalized_symbols",
    "input_packet_family_id",
    "input_packet_revision",
    "symbol_universe_snapshot_id",
    "universe_as_of_ms",
    "approved_universe_symbol",
    "event_types",
    "hypothesis_type",
    "allowed_horizons",
    "source_story_cluster_ids",
    "source_structured_packet_ids",
    "source_context_flag_packet_ids",
    "evidence_refs",
    "text_evidence",
    "metric_evidence",
    "market_context_ref",
    "data_quality_summary",
    "selected_market_artifacts",
    "candidate_class",
    "candidate_score",
    "score_breakdown",
    "research_priority",
    "research_eligible",
    "validation_requirements",
    "source_independence",
    "symbol_resolution_trace",
    "confidence_summary",
    "contradiction_summary",
    "observe_or_reject_reasons",
    "parent_artifact_ids",
    "storage_uri",
    "checksum",
    "idempotency_key"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_lifecycle_key": { "type": "string", "minLength": 1 },
    "bundle_key": { "type": "string", "minLength": 1 },
    "producer_app": { "const": "intel-candidate-app" },
    "producer_run_id": { "type": "string", "minLength": 1 },
    "created_at_ms": { "type": "integer" },
    "event_time_ms": { "type": "integer" },
    "published_at_ms": { "type": ["integer", "null"] },
    "fetched_at_ms": { "type": "integer" },
    "structured_at_ms": { "type": "integer" },
    "candidate_created_at_ms": { "type": "integer" },
    "decision_available_at_ms": { "type": "integer" },
    "forbidden_lookahead_boundary_ms": { "type": "integer" },
    "schema_version": { "const": "intel_candidate_evidence_bundle_v1" },
    "scoring_policy_version": { "type": "string", "minLength": 1 },
    "normalized_symbols": { "type": "array", "items": { "type": "string" } },
    "input_packet_family_id": { "type": "string", "minLength": 1 },
    "input_packet_revision": { "type": "integer", "minimum": 0 },
    "supersedes_packet_id": { "type": ["string", "null"] },
    "symbol_universe_snapshot_id": { "type": "string", "minLength": 1 },
    "universe_as_of_ms": { "type": "integer" },
    "approved_universe_symbol": { "type": "boolean" },
    "event_types": { "type": "array", "items": { "type": "string" } },
    "hypothesis_type": { "type": "string", "minLength": 1 },
    "allowed_horizons": {
      "type": "array",
      "items": { "type": "string", "enum": ["15m", "1h", "4h", "24h", "72h"] }
    },
    "source_story_cluster_ids": { "type": "array", "items": { "type": "string" } },
    "source_structured_packet_ids": { "type": "array", "items": { "type": "string" } },
    "source_context_flag_packet_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "text_evidence": { "type": "array", "items": { "type": "object" } },
    "metric_evidence": { "type": "array", "items": { "type": "object" } },
    "market_context_ref": { "type": ["object", "null"] },
    "data_quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_data_quality_summary_key", "status"],
      "properties": {
        "market_data_quality_summary_key": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    },
    "selected_market_artifacts": { "type": "array", "items": { "type": "object" } },
    "candidate_class": { "$ref": "#/$defs/candidate_class" },
    "candidate_score": { "type": "integer" },
    "score_breakdown": { "type": "object" },
    "research_priority": { "type": "string", "minLength": 1 },
    "research_eligible": { "type": "boolean" },
    "validation_requirements": { "type": "object" },
    "source_independence": { "type": "object" },
    "symbol_resolution_trace": { "type": "array", "items": { "type": "object" } },
    "confidence_summary": { "type": "object", "additionalProperties": { "type": "string" } },
    "contradiction_summary": { "type": "array", "items": { "type": "string" } },
    "observe_or_reject_reasons": { "type": "array", "items": { "type": "string" } },
    "parent_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "storage_uri": { "type": "string" },
    "checksum": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "candidate_class": {
      "type": "string",
      "enum": ["strong_candidate", "research_candidate", "weak_candidate", "observe_only", "reject", "quarantine"]
    }
  }
}
