{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nangman.local/contracts/intel-candidate/intel_candidate_pointer_v1.schema.json",
  "title": "Intel Candidate Artifact Pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_family",
    "candidate_id",
    "screening_event_id",
    "candidate_class",
    "storage_ref",
    "created_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "intel_candidate_pointer_v1" },
    "artifact_family": {
      "type": "string",
      "enum": [
        "intel_candidate_screening_event",
        "intel_candidate_evidence_bundle",
        "intel_candidate_hypothesis_state"
      ]
    },
    "candidate_id": { "type": ["string", "null"] },
    "screening_event_id": { "type": "string", "minLength": 1 },
    "candidate_class": {
      "type": "string",
      "enum": [
        "strong_candidate",
        "research_candidate",
        "weak_candidate",
        "observe_only",
        "reject",
        "quarantine"
      ]
    },
    "storage_ref": { "$ref": "#/$defs/s3_object_pointer" },
    "created_at_ms": { "type": "integer" }
  },
  "$defs": {
    "s3_object_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "content_sha256", "schema_version"],
      "properties": {
        "bucket": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^sha256:" },
        "schema_version": {
          "type": "string",
          "enum": [
            "intel_candidate_screening_event_v1",
            "intel_candidate_evidence_bundle_v1",
            "intel_candidate_hypothesis_state_v1"
          ]
        }
      }
    }
  }
}
