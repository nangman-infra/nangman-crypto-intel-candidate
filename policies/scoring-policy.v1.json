{
  "policy_version": "intel_candidate_scoring_v1",
  "schema_version": "intel_candidate_scoring_policy_v1",
  "hard_gates": {
    "forbid_missing_evidence": true,
    "forbid_missing_lineage": true,
    "forbid_invalid_schema": true,
    "forbid_forbidden_output_terms": true,
    "forbid_strong_when_market_context_pending": true,
    "forbid_strong_when_market_context_not_symbol_context": true,
    "forbid_strong_when_contradiction_medium_or_high": true,
    "forbid_strong_when_social_only": true,
    "require_decision_available_at_ms": true,
    "require_point_in_time_universe": true,
    "require_approved_universe_for_research": true,
    "require_data_quality_summary_for_research": true,
    "require_market_feature_delta_for_research": true,
    "require_market_regime_context_for_research": true,
    "require_source_independence_for_research": true,
    "require_symbol_resolution_trace_for_research": true,
    "forbid_source_event_count_as_diversity": true,
    "forbid_research_without_metric_delta_for_derivatives": true
  },
  "thresholds": {
    "strong_candidate": 85,
    "research_candidate": 60,
    "weak_candidate": 40,
    "observe_only_below": 40
  },
  "weights": {
    "symbol_confidence_strong": 20,
    "symbol_confidence_moderate": 10,
    "symbol_confidence_weak": -15,
    "source_independence_multi": 15,
    "official_source": 20,
    "market_context_available_symbol_context": 15,
    "market_context_available_general_context": 5,
    "market_context_pending": -20,
    "approved_universe_symbol": 15,
    "data_quality_good": 10,
    "symbol_resolution_strong": 10,
    "metric_delta_present": 10,
    "confidence_high": 20,
    "confidence_medium": 10,
    "confidence_low": -10,
    "novelty_high": 10,
    "novelty_medium": 5,
    "contradiction_low_penalty": -10,
    "contradiction_medium_penalty": -25,
    "contradiction_high_penalty": -100,
    "social_only_penalty": -15,
    "stale_event_penalty": -20,
    "legacy_evidence_weak_penalty": -20,
    "title_only_penalty": -20
  },
  "event_type_to_hypothesis_type": {
    "funding_shift": "derivatives_pressure_shift",
    "incident": "risk_incident_watch",
    "regulatory": "regulatory_catalyst_watch",
    "macro_event": "macro_regime_watch",
    "project_notice": "project_catalyst_watch",
    "governance": "governance_catalyst_watch",
    "exchange_listing": "venue_liquidity_expansion",
    "listing": "venue_liquidity_expansion",
    "exchange_delisting": "venue_liquidity_contraction",
    "delisting": "venue_liquidity_contraction",
    "social_hype": "attention_spike_watch",
    "social_backlash": "attention_spike_watch",
    "partnership": "project_catalyst_watch",
    "token_unlock": "project_catalyst_watch",
    "other": "general_intel_observation"
  },
  "event_type_to_allowed_horizons": {
    "funding_shift": ["1h", "4h", "24h"],
    "social_hype": ["1h", "4h"],
    "social_backlash": ["1h", "4h"],
    "incident": ["4h", "24h", "72h"],
    "regulatory": ["4h", "24h", "72h", "7d"],
    "project_notice": ["24h", "72h", "7d"],
    "governance": ["24h", "72h", "7d"],
    "macro_event": ["4h", "24h", "7d"],
    "exchange_listing": ["4h", "24h", "72h"],
    "listing": ["4h", "24h", "72h"],
    "exchange_delisting": ["4h", "24h", "72h"],
    "delisting": ["4h", "24h", "72h"],
    "other": ["24h"]
  },
  "market_context_pending_policy": {
    "default_class": "observe_only",
    "allow_research_candidate_for": ["official", "incident", "regulatory"],
    "research_candidate_still_requires": [
      "approved_universe_symbol",
      "source_independence",
      "symbol_resolution_trace",
      "data_quality_summary",
      "forbidden_lookahead_boundary"
    ],
    "observe_only_by_default_for": ["funding_shift", "derivatives_snapshot"],
    "max_class_for_social_hype": "weak_candidate"
  },
  "market_context_status_policy": {
    "strong_requires": "available_symbol_context",
    "research_allows": ["available_symbol_context", "available_general_context", "nearest_available", "symbol_context_only"],
    "pending_resolution": "use_market_context_pending_policy_first",
    "observe_only_by_default_for": ["unavailable"],
    "max_class_for_stale_but_usable": "weak_candidate"
  },
  "admission_requirements": {
    "strong_requires_approved_universe_symbol": true,
    "research_requires_approved_universe_symbol": true,
    "strong_min_independent_source_count": 2,
    "research_min_independent_source_count": 1,
    "official_source_can_replace_min_independent_source_count": true,
    "strong_allowed_symbol_mapping_confidence": ["moderate", "strong"],
    "research_allowed_symbol_mapping_confidence": ["moderate", "strong"],
    "derivatives_requires_metric_delta_for_research": true
  },
  "evidence_quality_reason_penalties": {
    "baseline_missing": -15,
    "single_numeric_snapshot": -25,
    "single_source_only": -15,
    "title_only": -20,
    "symbol_ambiguous": -25,
    "market_context_missing": -20,
    "duplicate_or_syndicated_source": -15,
    "approved_universe_missing": -100
  },
  "validation_requirement_defaults": {
    "required_adapters": ["native_replay"],
    "optional_adapters": ["freqtrade_style"],
    "min_unseen_windows": 20,
    "include_fee": true,
    "include_slippage": true,
    "include_latency_assumption": true,
    "include_liquidity_filter": true,
    "required_train_validation_split": true,
    "max_adapter_runtime_minutes": 30
  },
  "forbidden_output_terms": [
    "buy",
    "sell",
    "long",
    "short",
    "position_size",
    "live_ready",
    "execution_approved"
  ]
}
